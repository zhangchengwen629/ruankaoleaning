{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare build directory",
      "type": "process",
      "command": "/bin/mkdir",
      "args": [
        "-p",
        "${fileDirname}/.build"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build current C file",
      "type": "process",
      "command": "/usr/bin/clang",
      "args": [
        "-std=c17",
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/.build/${fileBasenameNoExtension}"
      ],
      "dependsOn": "Prepare build directory",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Build current C++ file",
      "type": "process",
      "command": "/usr/bin/clang++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/.build/${fileBasenameNoExtension}"
      ],
      "dependsOn": "Prepare build directory",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    }
  ]
}
